# TELEGRAM_BOT_TOKEN: The Bot API token obtained from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# INITIAL_SUPER_ADMIN_ID: Your numeric Telegram User ID. You can get this from @userinfobot.
INITIAL_SUPER_ADMIN_ID="123456789"

# WEBHOOK_SECRET: Optional secret token for Telegram webhook request validation.
WEBHOOK_SECRET="secret_token_phrase"

# DATABASE_URL: Optional PostgreSQL connection URI for persistent production database (e.g. Supabase, Neon, Cloud SQL).
# If not provided, an atomic persistent store is initialized in ./data/db.json.
DATABASE_URL="postgresql://username:password@hostname:5432/database"

# APP_URL: The public HTTPS URL where this app is hosted (e.g. Cloud Run / AI Studio URL).
# Used to register the Telegram webhook (e.g. https://my-app.run.app/api/telegram-webhook).
APP_URL="MY_APP_URL"

